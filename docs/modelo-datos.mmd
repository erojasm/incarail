    users {
        bigint id PK
        string name
        string email UK
        string password "hash bcrypt"
        boolean is_active
    }
    roles {
        bigint id PK
        string name UK
        string label
    }
    permissions {
        bigint id PK
        string name UK "ej. teams.read"
        string action "CASL"
        string subject "CASL"
    }
    competitions {
        bigint id PK "id de football-data"
        string code
        string name
        string area_name
        date season_start
        datetime imported_at
    }
    teams {
        bigint id PK "id de football-data"
        string name
        string tla
        string crest
        string venue
    }
    players {
        bigint id PK "id de football-data"
        bigint team_id FK
        string name
        string position
        smallint shirt_number
        date date_of_birth
    }
